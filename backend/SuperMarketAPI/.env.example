# Google Login (Backend)
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Razorpay Payment Gateway
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Brevo Email Service (SMTP)
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=SuperMarketApp

# SMTP Credentials (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# JWT Secret Key (Use a random long string for production)
JWT_KEY=your_long_random_jwt_secret_key_here
